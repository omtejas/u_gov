# ==============================================================================
# U-GOV V10 — Environment Variables Example (Zero-Cost Local & Sandbox)
# Copy to .env for local development. Never commit real keys, tokens, or secrets.
# ==============================================================================

# --- Core Server & Auth (Placeholders Only) ---
PORT=3000
SESSION_SECRET=
STATIC_DIR=
GOOGLE_CLIENT_ID=

# --- AI & Grounded Search (Leave Blank to Use Verified Local Knowledge Mode) ---
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# --- Local Storage & JSON Persistence Fallback (Works Without Docker/Cloud) ---
UGOV_DATA_DIR=
UGOV_STORAGE_MODE=
UGOV_STORAGE_TYPE=local
UGOV_S3_ACCESS_KEY_ID=
UGOV_S3_BUCKET=
UGOV_S3_ENDPOINT=
UGOV_S3_REGION=
UGOV_S3_SECRET_ACCESS_KEY=
UGOV_S3_SESSION_TOKEN=

# --- Local PostgreSQL 16 (Docker Compose — ₹0 Local Development) ---
# Leave DATABASE_URL blank to keep atomic JSON store fallback active.
POSTGRES_DB=ugov
POSTGRES_USER=ugov_dev
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=
# Example for local Docker PostgreSQL:
# DATABASE_URL=postgresql://ugov_dev:change_me_local_dev_only@127.0.0.1:5432/ugov

# --- Local Firebase Emulator Suite (₹0 — Never Targets Live Cloud / Blaze) ---
VITE_FIREBASE_USE_EMULATOR=false
VITE_FIREBASE_EMULATOR_PROJECT_ID=demo-ugov-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_EMULATOR_HUB_HOST=127.0.0.1:4400
FIREBASE_EMULATOR_UI_URL=http://127.0.0.1:4000