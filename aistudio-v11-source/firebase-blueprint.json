{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public citizen display profile without PII",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi", "mr", "kn"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "preferredLanguage", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Strictly owner-only PII profile record (Split Collection Strategy)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 25 },
        "state": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 60 },
        "kycLevel": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Citizen workspace and UI preferences",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi", "mr", "kn"] },
        "notificationsEnabled": { "type": "boolean" },
        "tutorialSeen": { "type": "boolean" },
        "dashboardLayout": { "type": "string", "enum": ["standard", "compact", "simple"] },
        "theme": { "type": "string", "enum": ["light", "high-contrast"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator role lookup marker",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "grantedAt"]
    },
    "CitizenDocument": {
      "title": "CitizenDocument",
      "description": "Private U-DOCS vault document metadata",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "documentTypeId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[A-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "documentNumber": { "type": "string", "minLength": 1, "maxLength": 80 },
        "mimeType": { "type": "string", "enum": ["application/pdf", "image/jpeg", "image/png"] },
        "sha256Checksum": { "type": "string", "minLength": 64, "maxLength": 64 },
        "verificationStatus": { "type": "string", "enum": ["UNVERIFIED", "SELF_ATTESTED", "SANDBOX_SIMULATED", "DIGILOCKER_VERIFIED"] },
        "version": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "documentTypeId", "title", "mimeType", "sha256Checksum", "verificationStatus", "createdAt", "updatedAt"]
    },
    "DocumentConsent": {
      "title": "DocumentConsent",
      "description": "Time-bound DPDP consent grant for a vault document",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "documentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientEntity": { "type": "string", "minLength": 1, "maxLength": 160 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
        "status": { "type": "string", "enum": ["ACTIVE", "REVOKED", "EXPIRED"] },
        "grantedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "documentId", "recipientEntity", "purpose", "status", "grantedAt", "expiresAt"]
    },
    "ApplicationRecord": {
      "title": "ApplicationRecord",
      "description": "Citizen government service application record",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "applicationNumber": { "type": "string", "minLength": 4, "maxLength": 64 },
        "status": { "type": "string", "enum": ["DRAFT", "DOCUMENTS_REQUIRED", "READY", "CONSENT_REQUIRED", "CONSENT_GRANTED", "SUBMITTED", "PROCESSING", "ACTION_REQUIRED", "APPROVED", "REJECTED", "CANCELLED"] },
        "attachedDocumentIds": { "type": "array" },
        "consentIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "serviceId", "applicationNumber", "status", "createdAt", "updatedAt"]
    },
    "GrievanceTicket": {
      "title": "GrievanceTicket",
      "description": "Civic grievance / issue solver record",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ticketId": { "type": "string", "minLength": 4, "maxLength": 40 },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "department": { "type": "string", "minLength": 2, "maxLength": 120 },
        "location": { "type": "string", "minLength": 2, "maxLength": 120 },
        "status": { "type": "string", "enum": ["Open", "Assigned", "In-Progress", "Resolved"] },
        "upvotes": { "type": "integer" },
        "description": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "ticketId", "title", "category", "department", "location", "status", "upvotes", "description", "createdAt", "updatedAt"]
    },
    "CitizenNotification": {
      "title": "CitizenNotification",
      "description": "Owner-scoped alert and status update",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "message": { "type": "string", "minLength": 1, "maxLength": 600 },
        "type": { "type": "string", "enum": ["info", "success", "warning", "alert", "status"] },
        "priority": { "type": "string", "enum": ["high", "normal", "low"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "message", "type", "priority", "read", "createdAt"]
    },
    "FeedbackItem": {
      "title": "FeedbackItem",
      "description": "Citizen feedback submission",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["bug", "feature", "ui", "service", "general", "security"] },
        "subject": { "type": "string", "minLength": 5, "maxLength": 100 },
        "message": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "rating": { "type": "integer" },
        "status": { "type": "string", "enum": ["RECEIVED", "REVIEWED", "RESOLVED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "category", "subject", "message", "status", "createdAt"]
    },
    "GovernmentService": {
      "title": "GovernmentService",
      "description": "Public catalogue entry for a government scheme or service",
      "type": "object",
      "properties": {
        "serviceCode": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 3, "maxLength": 160 },
        "department": { "type": "string", "minLength": 2, "maxLength": 160 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "status": { "type": "string", "enum": ["AVAILABLE", "SANDBOX_PROTOTYPE", "MAINTENANCE"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["serviceCode", "name", "department", "category", "status", "updatedAt"]
    },
    "WebHubPortal": {
      "title": "WebHubPortal",
      "description": "Curated official Indian government portal directory item",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 140 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "url": { "type": "string", "minLength": 10, "maxLength": 260 },
        "description": { "type": "string", "minLength": 5, "maxLength": 400 },
        "verifiedOfficial": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "url", "description", "verifiedOfficial", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public non-PII citizen display summary"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Strictly owner-only PII profile data (email, phone, location, KYC tier)"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "Citizen workspace and UI preferences"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator marker documents"
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "#/entities/CitizenDocument" },
      "description": "Owner-scoped U-DOCS metadata records"
    },
    "/documents/{documentId}/consents/{consentId}": {
      "schema": { "$ref": "#/entities/DocumentConsent" },
      "description": "Consent grants bound to a parent document via Master Gate lookup"
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/ApplicationRecord" },
      "description": "Citizen government service applications with terminal state protection"
    },
    "/grievances/{grievanceId}": {
      "schema": { "$ref": "#/entities/GrievanceTicket" },
      "description": "Civic grievance and issue solver tickets"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/CitizenNotification" },
      "description": "Owner-scoped citizen notifications"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/FeedbackItem" },
      "description": "Citizen feedback submissions"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/GovernmentService" },
      "description": "Public U-SERVICES catalogue entries (admin write only)"
    },
    "/webhubPortals/{portalId}": {
      "schema": { "$ref": "#/entities/WebHubPortal" },
      "description": "Curated official Government Web Hub portal directory (admin write only)"
    }
  }
}
