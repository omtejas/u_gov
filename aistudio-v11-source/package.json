{
  "name": "u-gov",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "U-GOV — Unified Governance & Citizen Services Platform",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "build:client": "vite build",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/server/tests/run-all.ts",
    "emulators:start": "firebase emulators:start --project demo-ugov-local",
    "emulators:auth": "firebase emulators:start --only auth --project demo-ugov-local",
    "cloud:up": "docker compose up -d postgres",
    "cloud:up:app": "docker compose --profile app up -d",
    "cloud:down": "docker compose --profile app down",
    "cloud:reset": "docker compose --profile app down -v",
    "cloud:ps": "docker compose --profile app ps"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "serverless-http": "^3.2.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
