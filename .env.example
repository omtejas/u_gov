# U-GOV Environment Configuration
PORT=3000
NODE_ENV=development

# Hosted AI provider (choose one or configure both; OpenAI-compatible provider takes priority)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint base, without /chat/completions
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini fallback/provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Public Internet search (Tavily preferred for extracted page content; Brave is fallback)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Session and Database (PostgreSQL)
SESSION_SECRET=
DATABASE_URL=postgresql://user:password@localhost:5432/ugov_db


# Private binary document storage (local for development, S3-compatible for hosted preview)
UGOV_STORAGE_TYPE=local
# For S3 set UGOV_STORAGE_TYPE=s3 and configure a private, encrypted bucket:
UGOV_S3_ENDPOINT=
UGOV_S3_BUCKET=
UGOV_S3_REGION=ap-south-1
UGOV_S3_ACCESS_KEY_ID=
UGOV_S3_SECRET_ACCESS_KEY=
UGOV_S3_SESSION_TOKEN=

# PostgreSQL is a planned V6 runtime target; DATABASE_URL is not yet consumed by the metadata store.
